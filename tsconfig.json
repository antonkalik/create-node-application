{
    "compilerOptions": {
      "outDir": "dist",
      "module": "CommonJS",
      "target": "ES2019",
      "esModuleInterop": true,
      "moduleResolution": "node",
      "declaration": true,
      "sourceMap": true,
      "allowSyntheticDefaultImports": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "skipLibCheck": true
    },
    "include": ["src/**/*"]
  }