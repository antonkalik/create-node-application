{
  "name": "create-node-application",
  "version": "0.0.0-development",
  "description": "A Node.js project generator tool that scaffolds out a structured application setup with best practices, developer tooling, and custom configurations. Designed for simplicity, ease of use, and to streamline the bootstrapping process of a new Node.js application. Includes ESBuild, TypeScript, ESLint, Prettier, Jest, and more, with a focus on developer experience and productivity. Created by Anton Kalik (github.com/antonkalik).",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --minify --outfile=dist/index.js",
    "lint": "eslint 'src/**/*.ts'",
    "semantic-release": "semantic-release --branches main",
    "commit": "cz"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "create-node-application": "./dist/index.js"
  },
  "lint-staged": {
    "**/*": "npx prettier --write --ignore-unknown",
    "src/**/*.{js,jsx,ts,tsx}": "npx eslint --fix"
  },
  "keywords": [
    "node",
    "typescript",
    "javascript",
    "esbuild",
    "cli",
    "create",
    "application",
    "starter",
    "template",
    "scaffold",
    "boilerplate"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/antonkalik/create-node-application.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Anton Kalik",
    "email": "antonkalik@gmail.com",
    "url": "https://idedy.com"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/github": "^11.0.2",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "eslint-plugin-n": "^17.17.0",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3",
    "semantic-release": "^24.2.3",
    "typescript-eslint": "^8.31.1"
  },
  "release": {
    "branches": [
      {
        "name": "main"
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "type": "feat",
              "release": "minor"
            },
            {
              "type": "fix",
              "release": "patch"
            },
            {
              "type": "refactor",
              "release": "patch"
            },
            {
              "type": "build",
              "release": "patch"
            },
            {
              "type": "chore",
              "release": "patch"
            },
            {
              "type": "minor",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      "@semantic-release/github",
      [
        "@semantic-release/changelog",
        {
          "changelogFile": "CHANGELOG.md"
        }
      ]
    ]
  },
  "engines": {
    "node": "22.x.x"
  },
  "type": "module",
  "dependencies": {
    "globals": "^16.0.0"
  }
}
